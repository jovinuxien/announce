<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE generatorConfiguration
        PUBLIC "-//mybatis.org//DTD MyBatis Generator Configuration 1.0//EN"
        "http://mybatis.org/dtd/mybatis-generator-config_1_0.dtd">

<generatorConfiguration>

    <context id="mysqlgenerator" targetRuntime="MyBatis3">
        <property name="autoDelimitKeywords" value="true"/>
        <!--可以使用``包括字段名，避免字段名与sql保留字冲突报错-->
        <property name="beginningDelimiter" value="`"/>
        <property name="endingDelimiter" value="`"/>

        <!-- 自动生成toString方法 -->
        <plugin type="org.mybatis.generator.plugins.ToStringPlugin"/>
        <!-- 自动生成equals方法和hashcode方法 -->
        <plugin type="org.mybatis.generator.plugins.EqualsHashCodePlugin"/>

        <!-- 非官方插件 https://github.com/itfsw/mybatis-generator-plugin -->
        <!-- 查询单条数据插件 -->
        <plugin type="com.itfsw.mybatis.generator.plugins.SelectOneByExamplePlugin"/>
        <!-- 查询结果选择性返回插件 -->
        <plugin type="com.itfsw.mybatis.generator.plugins.SelectSelectivePlugin"/>
        <!-- Example Criteria 增强插件 -->
        <plugin type="com.itfsw.mybatis.generator.plugins.ExampleEnhancedPlugin"/>
        <!-- 数据Model属性对应Column获取插件 -->
        <plugin type="com.itfsw.mybatis.generator.plugins.ModelColumnPlugin"/>
        <!-- 逻辑删除插件 -->
        <plugin type="com.itfsw.mybatis.generator.plugins.LogicalDeletePlugin">
            <!-- 这里配置的是全局逻辑删除列和逻辑删除值，当然在table中配置的值会覆盖该全局配置 -->
            <!-- 逻辑删除列类型只能为数字、字符串或者布尔类型 -->
            <property name="logicalDeleteColumn" value="deleted"/>
            <!-- 逻辑删除-已删除值 -->
            <property name="logicalDeleteValue" value="1"/>
            <!-- 逻辑删除-未删除值 -->
            <property name="logicalUnDeleteValue" value="0"/>
        </plugin>

        <commentGenerator>
            <property name="suppressDate" value="true"/>
            <!--<property name="suppressAllComments" value="true"/>-->
        </commentGenerator>

        <!--数据库连接信息-->
        <!-- announce_reactive_db; the mbg profile of db-reactive/pom.xml supplies these properties -->
        <jdbcConnection driverClass="com.mysql.cj.jdbc.Driver"
                        connectionURL="${mbg.url}"
                        userId="${mbg.user}"
                        password="${mbg.password}"/>

        <javaTypeResolver>
            <property name="useJSR310Types" value="true"/>
        </javaTypeResolver>

        <javaModelGenerator targetPackage="org.linlinjava.announce.db.domain" targetProject="src/main/java"/>
        <sqlMapGenerator targetPackage="org.linlinjava.announce.db.dao" targetProject="src/main/resources"/>
        <javaClientGenerator type="XMLMAPPER" targetPackage="org.linlinjava.announce.db.dao"
                             targetProject="src/main/java"/>
        <!--表名-->
        <table tableName="announce_ad">
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
        </table>
        <table tableName="announce_address">
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
        </table>
        <table tableName="announce_admin">
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
            <columnOverride column="role_ids" javaType="java.lang.Integer[]"
                            typeHandler="org.linlinjava.announce.db.mybatis.JsonIntegerArrayTypeHandler"/>
        </table>
        <table tableName="announce_brand">
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
        </table>
        <table tableName="announce_category" domainObjectName="LitemallCategory">
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
        </table>
        <table tableName="announce_collect">
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
        </table>
        <table tableName="announce_comment">
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
            <columnOverride column="pic_urls" javaType="java.lang.String[]"
                            typeHandler="org.linlinjava.announce.db.mybatis.JsonStringArrayTypeHandler"/>
        </table>

        <table tableName="announce_feedback">
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
            <columnOverride column="pic_urls" javaType="java.lang.String[]"
                            typeHandler="org.linlinjava.announce.db.mybatis.JsonStringArrayTypeHandler"/>
        </table>

        <table tableName="announce_footprint">
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
        </table>
        <!-- Announce read model (sql/announce_table.sql): the id is chosen by the command side, no generated key -->
        <table tableName="announce" domainObjectName="AnnounceBase">
            <columnOverride column="gallery" javaType="java.lang.String[]"
                            typeHandler="org.linlinjava.announce.db.mybatis.JsonStringArrayTypeHandler"/>
        </table>
        <table tableName="announce_goods_detail" domainObjectName="AnnounceGoodsDetail"/>
        <table tableName="announce_job" domainObjectName="AnnounceJobDetail"/>
        <table tableName="announce_event" domainObjectName="AnnounceEventDetail"/>
        <table tableName="crawled_listing" domainObjectName="CrawledListing">
            <columnOverride column="attributes" javaType="java.lang.String" jdbcType="VARCHAR"/>
        </table>
        <table tableName="listing_category_map" domainObjectName="ListingCategoryMap"/>
        <table tableName="announce_goods_attribute" domainObjectName="LitemallGoodsAttribute">
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
        </table>
        <table tableName="announce_goods_specification" domainObjectName="LitemallGoodsSpecification">
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
        </table>
        <table tableName="announce_goods_product" domainObjectName="LitemallGoodsProduct">
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
            <columnOverride column="specifications" javaType="java.lang.String[]"
                            typeHandler="org.linlinjava.announce.db.mybatis.JsonStringArrayTypeHandler"/>
        </table>
        <table tableName="announce_issue">
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
        </table>
        <table tableName="announce_keyword">
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
        </table>
        <table tableName="announce_region">
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
        </table>
        <table tableName="announce_search_history">
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
        </table>
        <table tableName="announce_storage">
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
        </table>
        <table tableName="announce_topic">
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
            <columnOverride column="goods" javaType="java.lang.Integer[]"
                            typeHandler="org.linlinjava.announce.db.mybatis.JsonIntegerArrayTypeHandler"/>
        </table>
        <!-- Refresh tokens issued by the gateway edges (id chosen by the edge, no generated key) -->
        <table tableName="announce_refresh_token" domainObjectName="AnnounceRefreshToken"/>
        <table tableName="announce_user">
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
        </table>
        <table tableName="announce_system">
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
        </table>

        <table tableName="announce_role">
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
        </table>
        <table tableName="announce_permission">
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
        </table>
        <table tableName="announce_log">
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
        </table>
        <table tableName="announce_notice">
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
        </table>
        <table tableName="announce_notice_admin">
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
        </table>
        <!-- Order module read models (sql/announce_order.sql): ids come from the command side, no generated keys -->
        <table tableName="announce_auction" domainObjectName="AnnounceAuction"/>
        <table tableName="announce_bid" domainObjectName="AnnounceBid"/>
        <table tableName="announce_auction_event" domainObjectName="AnnounceAuctionEvent">
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
        </table>
        <table tableName="announce_auction_seller" domainObjectName="AnnounceAuctionSeller"/>
        <table tableName="announce_order" domainObjectName="AnnounceOrder"/>
        <table tableName="announce_order_snapshot" domainObjectName="AnnounceOrderSnapshot"/>
        <table tableName="announce_order_seller" domainObjectName="AnnounceOrderSeller"/>
        <table tableName="announce_payment" domainObjectName="AnnouncePayment"/>
        <table tableName="announce_seller_account" domainObjectName="AnnounceSellerAccount"/>
        <table tableName="announce_shipment" domainObjectName="AnnounceShipment"/>
        <!-- Announce chat tables (sql/announce_auction_chat.sql) -->
        <table tableName="announce_featured_item">
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
        </table>
        <table tableName="announce_trade_rating">
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
        </table>
        <table tableName="announce_billing_info">
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
        </table>
        <!-- Messaging read models (sql/announce_messaging.sql): conversation and message ids are chosen by the
             Conversation aggregate (UUID), participant and bulletin rows keep an auto-increment id -->
        <table tableName="announce_conversation" domainObjectName="AnnounceConversation"/>
        <table tableName="announce_conversation_participant" domainObjectName="AnnounceConversationParticipant">
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
        </table>
        <table tableName="announce_chat_message" domainObjectName="AnnounceChatMessage"/>
        <table tableName="announce_bulletin" domainObjectName="AnnounceBulletin">
            <generatedKey column="id" sqlStatement="MySql" identity="true"/>
        </table>
    </context>
</generatorConfiguration>