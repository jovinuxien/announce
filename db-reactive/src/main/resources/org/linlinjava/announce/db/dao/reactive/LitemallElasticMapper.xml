<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.linlinjava.announce.db.dao.reactive.LitemallElasticMapper">

    <resultMap id="elasticDataResultMap" type="org.linlinjava.announce.db.dto.ElasticDto">
        <id column="id" jdbcType="INTEGER" property="id" />
        <result column="name" jdbcType="VARCHAR" property="goodName" />
        <result column="brief" jdbcType="VARCHAR" property="brief" />
        <result column="counter_price"  property="counterPrice" jdbcType="DECIMAL" javaType="java.math.BigDecimal"/>
        <result column="retail_price" property="retailPrice" jdbcType="DECIMAL" javaType="java.math.BigDecimal"/>
        <result column="categoryName" jdbcType="VARCHAR" property="categoryName" />
        <result column="manufacturer" jdbcType="VARCHAR" property="manufacturer" />
        <result column="attribute" jdbcType="VARCHAR" property="attribute" />
        <result column="parentCategoryName" jdbcType="VARCHAR" property="parentCategory" />
       <!-- <result column="previewImage" jdbcType="VARCHAR" property="pic" />
        <result column="categoryId" jdbcType="INTEGER" property="categoryId" />
        <result column="parentCategoryId" jdbcType="INTEGER" property="parentCategoryId" />
        <result column="brand_id" jdbcType="INTEGER" property="brandId" />-->
    </resultMap>


    <select id="selectGoodsWithJoin" resultMap="elasticDataResultMap">
        SELECT
        p.title AS name,
        p.brief,
        NULL AS counter_price,
        d.price AS retail_price,
        a.attribute,
        parent_c.name AS parentCategoryName,
        c.name AS categoryName,
        b.name AS manufacturer
        FROM
        announce p
        JOIN
        announce_goods_detail d ON d.announce_id = p.id
        JOIN
        announce_brand b ON d.brand_id = b.id
        JOIN
        announce_category c ON p.category_id = c.id
        LEFT JOIN
        announce_category parent_c ON c.pid = parent_c.id
        LEFT JOIN
        announce_goods_attribute a ON p.id = a.announce_id
        WHERE
        p.kind = 'GOODS' AND b.name = #{manufacturerName} AND a.attribute = #{attribute}
    </select>
</mapper>