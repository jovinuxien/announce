{
  "name": "@announce/customer-web",
  "version": "0.1.0",
  "private": true,
  "description": "Customer SPA of the announce marketplace, served by gateway-api (same-origin edge on port 8080).",
  "scripts": {
    "webapp:dev": "cross-env NODE_ENV=development webpack serve --config webpack/webpack.config.js",
    "webapp:prod": "cross-env NODE_ENV=production webpack --config webpack/webpack.config.prod.js",
    "build": "npm run webapp:prod",
    "test": "jest --config jest.conf.js",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "i18n:extract": "i18next --config i18next-parser.config.js",
    "i18n:check": "i18next --config i18next-parser.config.js --fail-on-update"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.3.0",
    "axios": "^1.7.7",
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "i18next": "^23.16.8",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.5",
    "react-dom": "^18.3.1",
    "react-i18next": "^14.1.3",
    "react-redux": "^9.1.2",
    "react-router-dom": "^6.27.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "copy-webpack-plugin": "^12.0.2",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "html-webpack-plugin": "^5.6.3",
    "i18next-parser": "^9.0.2",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "msw": "^2.6.4",
    "sass": "^1.80.6",
    "sass-loader": "^16.0.3",
    "style-loader": "^4.0.0",
    "terser-webpack-plugin": "^5.3.10",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "typescript": "^5.6.3",
    "webpack": "^5.96.1",
    "webpack-cli": "^5.1.4",
    "webpack-dev-server": "^5.1.0"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
