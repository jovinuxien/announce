<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.joviste</groupId>
        <artifactId>announce</artifactId>
        <version>0.0.1-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>messaging</artifactId>
    <packaging>jar</packaging>
    <name>Announce messaging</name>
    <description>Chat between members (about an announce) and with staff (support queue, bulletins): the Conversation
        aggregate on EventSourcingDB, read models in MySQL, WebSocket delivery fanned out through Kafka, public events
        on messaging.v1. Built like announce-management on cqrs-reactive and db-reactive.</description>

    <properties>
        <start-class>org.linlinjava.announce.messaging.MessagingApplication</start-class>
    </properties>

    <dependencies>
        <!-- Reactive persistence: the announce_* mappers (reactive-mybatis-support / R2DBC) -->
        <dependency>
            <groupId>org.joviste</groupId>
            <artifactId>db-reactive</artifactId>
        </dependency>
        <!-- CQRS framework: OpenCQRS command side, reactive projections, R2DBC checkpoints, relays, subscribers, clients -->
        <dependency>
            <groupId>org.joviste</groupId>
            <artifactId>cqrs-reactive</artifactId>
        </dependency>
        <!-- The published language of this service -->
        <dependency>
            <groupId>org.joviste</groupId>
            <artifactId>messaging-api</artifactId>
        </dependency>
        <!-- the order module's public records consumed from order.v1 -->
        <dependency>
            <groupId>org.joviste</groupId>
            <artifactId>order-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-r2dbc</artifactId>
        </dependency>
        <dependency>
            <groupId>io.asyncer</groupId>
            <artifactId>r2dbc-mysql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-stream-kafka</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-netflix-eureka-client</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
        </dependency>

        <!-- Test -->
        <dependency>
            <groupId>org.joviste</groupId>
            <artifactId>cqrs-reactive-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.projectreactor</groupId>
            <artifactId>reactor-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring-boot.version}</version>
                <configuration>
                    <mainClass>${start-class}</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
