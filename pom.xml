    <groupId>org.joviste</groupId>
    <artifactId>announce</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <packaging>pom</packaging>

    <properties>
        <java-version>21</java-version>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>

        <micrometer-tracing.version>1.2.2</micrometer-tracing.version>

        <spring-boot.version>3.5.11</spring-boot.version>
        <maven.deploy-plugin.version>3.1.1</maven.deploy-plugin.version>
        <spring-cloud.version>2025.0.3</spring-cloud.version>
        <maven-javadoc-plugin.version>3.10.1</maven-javadoc-plugin.version>
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.5.2</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.5.2</maven-failsafe-plugin.version>
        <maven-resources-plugin.version>3.3.1</maven-resources-plugin.version>
        <maven-enforcer-plugin.version>3.6.3</maven-enforcer-plugin.version>

        <!-- Shared by auth-server, announce-management, core and gateway -->
        <jhipster-dependencies.version>8.0.0-beta.2</jhipster-dependencies.version>

        <!-- Legacy litemall third-party SDKs still referenced by core (versions from the previous parent POM) -->
        <aliyun-java-sdk-core.version>4.0.3</aliyun-java-sdk-core.version>
        <aliyun-sdk-oss.version>2.5.0</aliyun-sdk-oss.version>
        <qcloudsms.version>1.0.5</qcloudsms.version>
        <cos_api.version>5.6.24</cos_api.version>
        <qiniu-java-sdk.version>[7.2.0, 7.2.99]</qiniu-java-sdk.version>
        <weixin-java.version>4.1.0</weixin-java.version>


        <typesafe.config.version>1.4.1</typesafe.config.version>

        <jib-maven-plugin.version>3.4.0</jib-maven-plugin.version>
        <jib-maven-plugin.image>eclipse-temurin:17-jre-focal</jib-maven-plugin.image>
        <jib-maven-plugin.architecture>amd64</jib-maven-plugin.architecture>
    </properties>
